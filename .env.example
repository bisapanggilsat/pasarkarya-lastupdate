PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret

# MySQL / MariaDB (XAMPP default: user root, password kosong)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pasarkarya

# Midtrans Sandbox: dashboard.midtrans.com > pilih mode Sandbox > Settings > Access Keys.
# Server Key itu rahasia: jangan di-commit dan jangan dibagikan.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false

# Buat akun & layanan demo saat server start. Default: true di development, false di production.
# SEED_DEMO=true

# Optional: set a specific frontend origin for deployment; leave unset for local development.
# CLIENT_URL=http://localhost:5173
# For a separately hosted API, set VITE_API_URL in the frontend build environment.
